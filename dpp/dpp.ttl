    rdfs:comment "Valeur de la métrique avec unité."@fr ;
    rdfs:domain dpp:Metric ;
    rdfs:range schema:QuantitativeValue ;
    rdfs:isDefinedBy <https://ns.verisav.fr/dpp#> ;
