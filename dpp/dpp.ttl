    rdfs:label "nom du critère"@fr ;
    rdfs:comment "Name of the criterion."@en ;
    rdfs:comment "Nom du critère."@fr ;
    rdfs:domain dpp:Criterion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://ns.verisav.fr/dpp#> ;
